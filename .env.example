# Palette configuration — copy to .env and fill in. .env is gitignored and
# excluded from image builds (.dockerignore) and cloud-build uploads (.ceignore).
# Read by: `make dev`, `make serve-*` (local service), deployment/*.sh.

# ============================================================================
# Model backends (runtime)
# ============================================================================
# Designer + coder: the fine-tuned palette model on the Code Engine fleet
# (palette-model-fleet repo). Bearer key = that repo's .serve_api_key.
PALETTE_CE_BASE_URL=http://<palette-lb-hostname>/v1
PALETTE_CE_API_KEY=

# Crafter + editor: gpt-oss-120b on watsonx.ai (only us-south hosts it).
GPT_OSS_120B_PROVIDER=watsonx
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
# WATSONX_SPACE_ID=           # alternative to WATSONX_PROJECT_ID

# RITS — only for models not covered above (Llama-3.3-70B, the gpt-oss-20b
# LoRA, base Qwen-Coder in the UI menus). Leave unset for a RITS-free setup;
# those menu entries are then greyed out.
# RITS_API_KEY=

# ============================================================================
# Local service (make serve-start / make dev)
# ============================================================================
PALETTE_PORT=18814
PALETTE_HOME=/path/to/project-palette
PALETTE_WORKSPACE=~/.local/state/palette/workspace

# ============================================================================
# Code Engine deployment (make ce-cloud-build && make ce-deploy)
# ============================================================================
ICR_REGION=icr.io
ICR_NAMESPACE=<icr-namespace>
IMAGE_NAME=palette-agent
IMAGE_TAG=latest
CE_REGION=us-east
CE_RESOURCE_GROUP=<resource-group>
CE_PROJECT=<ce-project>
CE_APP_NAME=palette-agent
# Pull secret for ICR_REGION (no inline comments on value lines — not every
# reader strips them).
CE_REGISTRY_SECRET=<registry-secret>
# Empty = no RITS secret (requires the CE fleet + watsonx settings above).
CE_SECRET_NAME=
CE_CPU=4
CE_MEMORY=8G
CE_MIN_SCALE=1
CE_MAX_SCALE=1
